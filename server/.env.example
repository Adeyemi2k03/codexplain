# Groq API key — sign up free at https://groq.com (no credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Port the API server listens on
PORT=3002

# Frontend origin for CORS (must match your Vite dev server URL)
FRONTEND_URL=http://localhost:5173

# Set to "development" to see detailed error messages
NODE_ENV=development
