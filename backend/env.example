# Django
DJANGO_SECRET_KEY=your-secret-key-generate-with-python-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=codexplain
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Redis (used for both cache and Celery broker)
REDIS_URL=redis://127.0.0.1:6379/0

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MAX_TOKENS=1200

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://codexplain-coral.vercel.app
